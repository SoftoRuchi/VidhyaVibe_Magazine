# API (services/api)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/magazine
PORT=2034
NODE_ENV=development

# Optional: Redis for caching
# REDIS_URL=redis://127.0.0.1:6379

# Optional: S3/MinIO for production storage
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=127.0.0.1:9000
# STORAGE_BUCKET=magazine
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin

# JWT (required in production — use long random strings)
# Access token lifetime: 15m = 15 minutes (do NOT use bare "2" — that was misread as 2 seconds before normalization)
JWT_ACCESS_SECRET=mZvFQTD0ECZVnmq8W1AN7k2uJwhk1Xf3VjhAN8uU22p8cDO9imgLm4/HqqvcgNJl
JWT_REFRESH_SECRET=mZvFQTD0ECZVnmq8W1AN7k2uJwhk1Xf3VjhAN8uU22p8cDO9imgLm4/HqqvcgNJl
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=30d

# Login brute-force limit (default 10 per RATE_LIMIT_WINDOW_MS, usually 15 min).
# Login limiting is skipped when NODE_ENV=development.
# Set to 0 to disable login rate limiting (e.g. staging only — not for production).
# LOGIN_RATE_LIMIT_MAX=50

# --- Email (optional .env fallback — prefer Admin → Email Settings in DB) ---
# Hostinger defaults are seeded in email_settings table:
#   smtp.hostinger.com:465 SSL, support@vidhyavibe.in
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=support@vidhyavibe.in
# SMTP_PASS=your_mailbox_password
# EMAIL_RECEIVER=support@vidhyavibe.in

# WhatsApp Business (Meta Cloud API) — sender display number
WHATSAPP_FROM=7703992977
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Optional approved templates for cold outreach:
# WHATSAPP_TEMPLATE_ACK=checkout_started
# WHATSAPP_TEMPLATE_CONFIRM=purchase_confirmation
# WHATSAPP_TEMPLATE_LANG=en

# Or Resend:
# RESEND_API_KEY=re_...
# EMAIL_FROM=VidhyaVibe <support@vidhyavibe.in>

# AI activity generator for mobile Learn tab (FREE — Google Gemini by default)
# Get a free key: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# Optional alternative free provider: https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ACTIVITY_GENERATE_RATE_LIMIT_MAX=30
