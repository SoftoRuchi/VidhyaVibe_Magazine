# Admin app (apps/admin) — copy to .env.local for local dev

PORT=3034

# Proxy /api/* to the API (local dev: API on port 2034)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:2034

# "Read Magazine" link (runtime on server — use READER_BASE_URL in Docker/production)
READER_BASE_URL=https://reader.vidhyavibe.in
NEXT_PUBLIC_READER_URL=https://reader.vidhyavibe.in

# Local dev reader:
# READER_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_READER_URL=http://localhost:3000
